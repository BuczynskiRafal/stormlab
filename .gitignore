# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
wheels/
.eggs/

# Virtual environments and local configuration
.venv/
venv/
env/
.env

# Tests, coverage and tool caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.mypy_cache/
.ruff_cache/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
app/media/*
app/staticfiles/*

# SWMM writes its report, binary output and backup next to the input file
# (the two files beside the test network are fixtures and stay tracked)
*.rpt
*.out
*.bak
!app/sa/core/tests/test_file.rpt
!app/sa/core/tests/test_file.out

# IDE and OS files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Model files: weights are ignored unless listed below.
# The shipped models are the recommendation weights, their spec and the classifier.
*.keras
*.weights.h5
app/sa/core/recommendations/*.spec.json
!app/sa/core/recommendations/gnn_recommender.run[1-5].weights.h5
!app/sa/core/recommendations/gnn_recommender.spec.json
!app/sa/core/catchment_classifier/model.keras
