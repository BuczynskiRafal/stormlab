# Copy to app/.env (development) or pass to the container (production).
# Unset or blank variables use the default shown in the comment.

# --- Development (defaults work as is) ---

# development (default), production or testing
DJANGO_ENV=development

# Optional outside production; development uses a fixed insecure key when unset.
# SECRET_KEY=

# Self-registration (default true). When false, /accounts/register/ answers 404.
# REGISTRATION_OPEN=true

# Largest accepted .inp upload in bytes (default 52428800 = 50 MB).
# MAX_INP_BYTES=52428800

# Storage locations (defaults: app/db.sqlite3, app/media, app/staticfiles).
# SQLITE_PATH=/data/db.sqlite3
# MEDIA_ROOT=/data/media
# STATIC_ROOT=/srv/static

# --- Production (DJANGO_ENV=production) ---

# Required: at least 50 random characters. Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# SECRET_KEY=

# Required: comma-separated host names served by this site.
# ALLOWED_HOSTS=example.com,www.example.com

# Only needed when the proxy changes the Host header or the site has several origins.
# CSRF_TRUSTED_ORIGINS=https://example.com

# HSTS (defaults: 3600 seconds, false, false). Raise only once HTTPS is known to work.
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false
