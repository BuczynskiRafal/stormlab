# Copy to app/.env (development) or pass to the container (production).
# Unset or blank variables use the default shown in the comment.

# --- Development (defaults work as is) ---

# development (default), production or testing
DJANGO_ENV=development

# Optional outside production; development uses a fixed insecure key when unset.
# SECRET_KEY=

# Self-registration (default true). When false, /accounts/register/ answers 404.
# REGISTRATION_OPEN=true

# Largest accepted .inp upload in bytes (default 52428800 = 50 MB).
# MAX_INP_BYTES=52428800

# What one analysis may cost, checked by the upload form from the file (the run happens
# inside the request and writes its binary output to the temporary directory).
# Conduits + nodes + subcatchments (default 5000).
# MAX_MODEL_ELEMENTS=5000
# Simulated time from START to END, in hours (default 168, one week).
# MAX_SIMULATION_HOURS=168
# Estimated binary output, elements x report steps x 24 bytes, in MB (default 200).
# MAX_OUTPUT_MB=200
# Estimated routing work, elements (at least 50) x simulated time / ROUTING_STEP,
# in millions of element routing steps (default 100).
# MAX_ROUTING_MILLIONS=100

# --- Recommendation model (operator switches; the defaults serve the shipped model) ---
# Read by app/sa/core/predictor.py. The files live in app/sa/core/recommendations/.
# All but GNN_ENABLED are read once, when the process starts.

# Use the graph model. 1, true, yes or on enable it; any other value switches it off, and
# analyses then complete without recommendations unless the optional MLP model is
# installed. Default: on when at least one configured weight file exists.
# GNN_ENABLED=true
# Weight files of the ensemble, comma-separated; their outputs are averaged
# (default: gnn_recommender.run1.weights.h5 to gnn_recommender.run5.weights.h5).
# GNN_WEIGHTS=
# Model specification (default gnn_recommender.spec.json).
# GNN_SPEC=gnn_recommender.spec.json
# Imputation plan for missing feature values (default gnn_recommender.imputation.json).
# GNN_IMPUTATION=gnn_recommender.imputation.json
# Identifier stored with every analysis; it does not affect loading (default gnn_recommender_v1).
# GNN_MODEL_ID=gnn_recommender_v1
# Hops of the older adjacency path, used only for a model without a specification (default 2).
# GNN_MAX_HOPS=2

# Storage locations (defaults: app/db.sqlite3, app/media, app/staticfiles).
# SQLITE_PATH=/data/db.sqlite3
# MEDIA_ROOT=/data/media
# STATIC_ROOT=/srv/static

# --- Production (DJANGO_ENV=production) ---

# Required: at least 50 random characters. Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# SECRET_KEY=

# Required: comma-separated host names served by this site.
# ALLOWED_HOSTS=example.com,www.example.com

# Only needed when the proxy changes the Host header or the site has several origins.
# CSRF_TRUSTED_ORIGINS=https://example.com

# HSTS (defaults: 3600 seconds, false, false). Raise only once HTTPS is known to work.
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false
